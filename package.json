{
  "name": "squish",
  "productName": "Squish",
  "version": "1.0.0",
  "description": "A squishy, translucent stress ball that lives on your desktop.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "pack": "electron-builder --dir"
  },
  "author": "Your Name",
  "license": "MIT",
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.squish.app",
    "productName": "Squish",
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "build/icon.png"
    ],
    "mac": {
      "icon": "build/icon.png",
      "category": "public.app-category.entertainment",
      "identity": null,
      "target": ["dmg", "dir"]
    },
    "dmg": {
      "sign": false
    },
    "win": {
      "icon": "build/icon.png",
      "target": ["nsis", "portable"]
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "Game",
      "target": ["AppImage"]
    }
  }
}
